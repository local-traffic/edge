[Unit]
Description=Local Traffic Detection System
After=network.target
Wants=network-online.target

[Service]
Type=simple
User={{ ssh_user }}
Group={{ ssh_user }}
WorkingDirectory={{ app_dir }}/
EnvironmentFile={{ env_file_path }}
ExecStart={{ venv_path }}/bin/python {{ app_dir }}/main.py {{ cmd_args }}
#Restart=always
#RestartSec=10
StandardOutput=journal
StandardError=journal

# Resource limits
#MemoryMax=2G
#CPUQuota=80%

[Install]
WantedBy=multi-user.target
